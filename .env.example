# --- Core ---
NODE_ENV=production
APP_URL=https://scheduler.example.com
# Secure session cookie. Unset = follow APP_URL scheme (https => true). Set false only when
# you deliberately terminate TLS on a proxy and browsers reach this app over plain HTTP.
COOKIE_SECURE=
DATABASE_URL="file:../data/tiktok-scheduler.db"

# --- Redis (BullMQ queue + locks) ---
REDIS_URL=redis://redis:6379

# --- Secrets (required, generate with: openssl rand -hex 32) ---
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Storage ---
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=287
UPLOAD_CONCURRENCY=3

# --- TikTok Content Posting API ---
# Requires an approved TikTok developer app with content.posting scopes.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://scheduler.example.com/api/tiktok/callback
# mock | live
TIKTOK_API_MODE=live
TIKTOK_API_BASE_URL=https://open.tiktokapis.com

# --- Backups (worker writes data/backups/*.db once a day) ---
BACKUP_INTERVAL_HOURS=24
BACKUP_RETAIN=7

# --- Worker ---
WORKER_CONCURRENCY=2
WORKER_QUEUE_PAUSED=false
PUBLISH_JOB_TIMEOUT_MS=600000
PUBLISH_MAX_RETRIES=3
SCHEDULE_SCAN_INTERVAL_MS=30000

# --- Optional Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=